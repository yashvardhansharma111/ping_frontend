{
  "expo": {
    "name": "Ping",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ping",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pingnow.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "tg",
          "telegram",
          "instagram",
          "sms"
        ]
      }
    },
    "android": {
      "package": "com.pingnow.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#080815",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#7C3AED"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ping uses your location to show nearby activities and let friends find you.",
          "locationAlwaysAndWhenInUsePermission": "Ping uses your location to show nearby activities and let friends find you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3ECFF",
          "dark": {
            "backgroundColor": "#080815"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://ytterbic-tammy-yashvardhan-2deb3c9f.koyeb.app",
      "eas": {
        "projectId": "04768189-03f7-478e-92d3-6d30fb5f68b9"
      },
      "router": {}
    }
  }
}
