{
  "expo": {
    "name": "Ping",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ping",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pingnow.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "tg",
          "telegram",
          "instagram",
          "sms"
        ]
      }
    },
    "android": {
      "package": "com.pingnow.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#080815",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "navigationBar": {
        "backgroundColor": "#0F0F12",
        "barStyle": "light-content"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#7C3AED",
          "mode": "production"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ping uses your location to show nearby activities and let friends find you.",
          "locationAlwaysAndWhenInUsePermission": "Ping uses your location to show nearby activities and let friends find you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3ECFF",
          "dark": {
            "backgroundColor": "#080815"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-updates"
    ],
    "updates": {
      "url": "https://u.expo.dev/b38efb15-2d7b-4392-ab8b-720a7a2a83f3",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 8000
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://ytterbic-tammy-yashvardhan-2deb3c9f.koyeb.app",
      "router": {},
      "eas": {
        "projectId": "b38efb15-2d7b-4392-ab8b-720a7a2a83f3"
      }
    },
    "owner": "yashvardhan001-2"
  }
}
